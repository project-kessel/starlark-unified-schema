{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "gomod": {
    "schedule": ["* 0-7 * * 0"]
  },
  "packageRules": [
    {
      "matchManagers": ["gomod", "github-actions"],
      "enabled": true,
      "groupName": "Dependency updates",
      "group": {
        "branchTopic": "dependency-updates",
        "commitMessageTopic": "dependencies"
      }
    }
  ]
}
